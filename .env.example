# CloudNet Environment Configuration

# Application
PROJECT_NAME="CloudNet: National Weather Big Data Analytics Platform"
ENVIRONMENT="development"
DEBUG=True

# Security & Secrets (Override in production!)
SECRET_KEY="cloudnet-sih-2026-national-weather-security-key-super-secure"
ADMIN_USERNAME="admin"
ADMIN_EMAIL="admin@cloudnet.gov.in"
ADMIN_PASSWORD="CloudNet@Admin2026"

# Database Configuration
# Local development default: SQLite (zero configuration required)
DATABASE_URL="sqlite+aiosqlite:///./cloudnet.db"
# Production PostgreSQL + PostGIS:
# DATABASE_URL="postgresql+asyncpg://cloudnet:cloudnet_password@localhost:5432/cloudnet_db"

# Redis Streaming Queue
REDIS_URL="redis://localhost:6379/0"
USE_REDIS=false

# Object Storage (MinIO / S3)
STORAGE_TYPE="local"
STORAGE_DIR="./storage"

# Frontend API URL
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_WS_URL="ws://localhost:8000/ws/events"
